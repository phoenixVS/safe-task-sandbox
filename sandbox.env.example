# Copy to sandbox.env and edit:  cp sandbox.env.example sandbox.env
# Values are read by docker compose and sandbox.sh. Write a literal $ as $$.
# Anything you also set in your shell wins over this file.

# --- What to run ---------------------------------------------------------------------
# https://... (public, or private with GIT_TOKEN), or /src for a local repo (see REPO_PATH).
REPO_URL=https://github.com/OWNER/REPO.git

# REQUIRED. The full 40-character commit SHA you reviewed. Setup stops if the repo is not exactly this.
EXPECTED_COMMIT=

# Optional: branch or tag to check out before verifying (default: the repo's default branch).
# REPO_REF=main

# Optional: absolute path of a local git repo to clone from (mounted read-only at /src).
# REPO_PATH=/Users/me/take-home-task

# --- How to run it -------------------------------------------------------------------
# Runs in the setup container, WITH internet, without any git token. Repo code may run here.
INSTALL_CMD="npm install"

# Runs in the app container, WITHOUT internet. Must listen on 0.0.0.0.
START_CMD="npm start"

# Run by ./sandbox.sh test, also WITHOUT internet.
TEST_CMD="npm test"

# Ports forwarded to 127.0.0.1 on your machine (space separated, 1024-65535).
PORTS="3000"

# --- Optional ------------------------------------------------------------------------
# Debian/Ubuntu based images only. Examples:
#   BASE_IMAGE=python:3.12-slim-bookworm   INSTALL_CMD="pip install --only-binary=:all: -r requirements.txt"
#   BASE_IMAGE=golang:1.23-bookworm        INSTALL_CMD="go mod download"
# BASE_IMAGE=node:22-bookworm-slim
# MEM_LIMIT=6g
# PIDS_LIMIT=512
# CLAUDE_CODE_VERSION=2.1.319
# BROWSER_URL=http://localhost:3000
